erDiagram
    Form ||--o{ Question : "has (cascade delete)"
    Form ||--o{ Submission : "receives (cascade delete)"
    Submission ||--o{ Answer : "contains (cascade delete)"
    Question ||--o{ Answer : "is answered by (cascade delete)"

    Form {
        string id PK "cuid"
        string title
        string description "optional"
        boolean published "default true"
        datetime createdAt
    }
    Question {
        string id PK "cuid"
        string formId FK
        string label
        string type "short_text, long_text, number, email, date, single_choice, multi_choice, file"
        boolean required
        string_array options "choices for choice types"
        int order "position inside the form"
    }
    Submission {
        string id PK "cuid"
        string formId FK
        datetime createdAt
    }
    Answer {
        string id PK "cuid"
        string submissionId FK
        string questionId FK
        json value "string, list of strings, or file id"
    }